# ====================================================================
# MCOA Social Publisher - Environment Configuration Template
# Medical Coding Officers Academy
# Copy to .env.local and populate with your verified credentials
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ====================================================================

# 1. APPLICATION URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. SUPABASE CONFIGURATION
# Found in Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# NEVER expose the service role key to the browser (keep on server only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. SERVER-SIDE AES-256-GCM TOKEN ENCRYPTION KEY
# Must be exactly 32 bytes (64 hex characters). Generate using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 4. DURABLE WORKER & SCHEDULER SECURITY
# Secret token to authorize /api/cron/publish requests from pg_cron or Vercel Cron
CRON_SECRET=mcoa_cron_secret_replace_with_secure_random_token

# 5. META DEVELOPERS APP (Facebook Pages & Instagram Professional)
# Found in Meta Developer Portal -> App Settings -> Basic
META_APP_ID=your_meta_app_id
NEXT_PUBLIC_META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# 6. GOOGLE CLOUD PROJECT (Google Business Profile)
# Found in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 7. GOOGLE BUSINESS PROFILE LIVE PUBLISHING GATE
# Mandatory security rule: Keep 'false' until your Google Cloud project receives
# formal approval for Google Business Profile API access.
ENABLE_GOOGLE_BUSINESS_LIVE_PUBLISHING=false
